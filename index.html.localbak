function renderAll(){var c=document.getElementById('all-topics'),h='';for(var k in CATS){var cat=CATS[k];h+='<div class="tb-cat-block show" data-c="'+k+'"><div class="tb-cat-h"><h3>'+cat.t+'</h3><span class="cnt">'+cat.c+'</span></div>';cat.cards.forEach(function(cd){h+='<div class="tb-article" onclick="window.open(\''+(WX+cd.l+'#wechat_redirect')+'\',\'_blank\')"><div class="ta-main"><h4>'+cd.t+'</h4><div class="ta-desc">'+cd.s+'</div><div class="ta-tags">';cd.a.forEach(function(t){h+='<span>'+t+'</span>'});h+='</div></div><div class="ta-right"><div class="ta-count">'+cd.n+'</div><div class="ta-link">阅读 →</div></div></div>'});h+='</div>'}c.innerHTML=h}
renderAll();

function switchPage(n){
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active')});
  document.getElementById('page-'+n).classList.add('active');
  document.querySelectorAll('.nav-links a').forEach(function(a){a.classList.remove('active')});
  var m={home:0,toolbox:1,about:2};
  document.querySelectorAll('.nav-links a')[m[n]].classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  setTimeout(initReveal,120);
}
function switchPageAndTab(p,tab){switchPage(p);if(p==='toolbox')setTimeout(function(){document.querySelectorAll('.tb-tab').forEach(function(t){if(t.dataset.cap===tab)switchCap(tab,t)})},180)}
function switchCap(cap,el){
  document.querySelectorAll('.tb-tab').forEach(function(t){t.classList.remove('active')});
  el.classList.add('active');
  document.querySelectorAll('.tb-panel').forEach(function(s){s.classList.toggle('show',cap==='all'||s.dataset.cap===cap)});
}
function fc(c,el){
  document.querySelectorAll('.tb-cat-tab').forEach(function(t){t.classList.remove('active')});
  if(el)el.classList.add('active');
  document.querySelectorAll('#all-topics .tb-cat-block').forEach(function(b){b.classList.toggle('show',c==='all'||b.dataset.c===c)});
}
window.addEventListener('scroll',function(){document.getElementById('nav').classList.toggle('scrolled',window.scrollY>20)});
function initReveal(){
  var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.reveal').forEach(function(el){obs.observe(el)});
}
initReveal();
</script>
