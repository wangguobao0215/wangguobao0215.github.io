<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="树懒老K（拙一）——二十五年来在车间和会议室之间行走，用原创方法论帮你建立定义问题、梳理问题、做出判断的能力。">
<meta property="og:title" content="树懒老K — AI时代不可替代的底层能力">
<meta property="og:description" content="AI时代最值钱的不是技术，是定义问题、梳理问题、做出判断的能力。">
<meta property="og:image" content="https://wangguobao0215.github.io/assets/avatar.png">
<meta property="og:type" content="website">
<title>树懒老K — 雾中见山</title>
<style>
/* ============================================================
   树懒老K · v4 —「雾中见山」
   雾霁蓝 · 玻璃质感 · 景深叙事 · 突破天花板
   ============================================================ */
:root{
  --ice:#f5f8fb;--mist:#edf3f8;--haze:#e2ebf3;--glass:rgba(255,255,255,.62);
  --blue-pale:#d0e4f2;--blue-light:#a3c8e0;--blue-mid:#6b9ec8;--blue-deep:#3d6d90;--blue-ink:#1e3b52;
  --accent:#5b92b8;--accent-glow:rgba(91,146,184,.28);
  --text:#182c3c;--text-body:#3a5468;--text-muted:#688298;--text-faint:#94a8b8;
  --border:#dbe6f0;--border-glass:rgba(219,230,240,.5);
  --dark:#0c1722;--dark2:#142230;--dark-glass:rgba(12,23,34,.94);
  --radius:14px;--radius-sm:8px;--radius-pill:40px;
  --shadow-sm:0 1px 3px rgba(12,23,34,.04);
  --shadow-md:0 4px 20px rgba(12,23,34,.06);
  --shadow-lg:0 12px 40px rgba(12,23,34,.08);
  --shadow-glow:0 0 60px var(--accent-glow);
  --font: -apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans SC","Microsoft YaHei",sans-serif;
  --max:1040px;--ease: cubic-bezier(.22,.61,.36,1);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:var(--ice);color:var(--text-body);line-height:1.78;-webkit-font-smoothing:antialiased;overflow-x:hidden}

/* === NOISE TEXTURE OVERLAY === */
body::after{content:'';position:fixed;inset:0;z-index:99999;pointer-events:none;opacity:.035;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-repeat:repeat;background-size:180px 180px;}

/* === ANIMATIONS === */
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}
@keyframes floatSlow{0%,100%{transform:translate(0,0)}33%{transform:translate(8px,-6px)}66%{transform:translate(-6px,10px)}}
@keyframes pulse{0%,100%{opacity:.35}50%{opacity:.7}}
@keyframes drift1{0%{transform:translate(0,0)scale(1)}25%{transform:translate(30px,-20px)scale(1.3)}50%{transform:translate(-15px,-10px)scale(.8)}75%{transform:translate(-25px,15px)scale(1.2)}100%{transform:translate(0,0)scale(1)}}
@keyframes drift2{0%{transform:translate(0,0)scale(1)}25%{transform:translate(-25px,-8px)scale(.7)}50%{transform:translate(20px,15px)scale(1.4)}75%{transform:translate(8px,-18px)scale(.9)}100%{transform:translate(0,0)scale(1)}}
@keyframes drift3{0%{transform:translate(0,0)scale(1)}25%{transform:translate(15px,12px)scale(1.2)}50%{transform:translate(-20px,-5px)scale(.7)}75%{transform:translate(-8px,20px)scale(1.3)}100%{transform:translate(0,0)scale(1)}}
@keyframes fogMove1{0%,100%{transform:translateX(-5%)translateY(0)}50%{transform:translateX(5%)translateY(-3%)}}
@keyframes fogMove2{0%,100%{transform:translateX(5%)translateY(0)}50%{transform:translateX(-5%)translateY(2%)}}
@keyframes fogMove3{0%,100%{transform:translateX(-3%)translateY(-2%)}50%{transform:translateX(3%)translateY(2%)}}
@keyframes shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(200%)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes scaleIn{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@keyframes countUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes glint{0%{left:-100%}50%,100%{left:200%}}

/* === REVEAL SYSTEM === */
.reveal{opacity:0;transform:translateY(36px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-delay-1{transition-delay:.1s}.reveal-delay-2{transition-delay:.2s}.reveal-delay-3{transition-delay:.3s}.reveal-delay-4{transition-delay:.4s}.reveal-delay-5{transition-delay:.5s}

/* === NAV === */
.nav{position:fixed;top:0;left:0;right:0;z-index:1000;display:flex;align-items:center;justify-content:space-between;padding:0 44px;height:60px;background:rgba(245,248,251,.78);backdrop-filter:blur(24px) saturate(1.4);-webkit-backdrop-filter:blur(24px) saturate(1.4);border-bottom:1px solid transparent;transition:all .35s var(--ease)}
.nav.scrolled{border-bottom-color:var(--border-glass);background:rgba(245,248,251,.92);box-shadow:0 1px 20px rgba(12,23,34,.04)}
.nav-brand{display:flex;align-items:center;gap:10px;cursor:pointer;text-decoration:none}
.nav-brand img{width:30px;height:30px;border-radius:50%;border:2px solid var(--blue-light)}
.nav-brand span{font-size:15px;font-weight:700;color:var(--blue-ink);letter-spacing:4px}
.nav-links{display:flex;gap:4px;list-style:none}
.nav-links a{padding:7px 18px;border-radius:var(--radius-pill);font-size:13px;color:var(--text-muted);cursor:pointer;transition:all .28s var(--ease);text-decoration:none;font-weight:500;position:relative;overflow:hidden}
.nav-links a::before{content:'';position:absolute;inset:0;background:var(--blue-mid);opacity:0;border-radius:var(--radius-pill);transition:opacity .28s var(--ease)}
.nav-links a:hover{color:var(--blue-deep)}
.nav-links a:hover::before{opacity:.07}
.nav-links a.active{color:#fff;font-weight:600;box-shadow:0 4px 16px rgba(61,109,144,.25)}
.nav-links a.active::before{opacity:1;background:linear-gradient(135deg,var(--blue-mid),var(--blue-deep))}
.nav-links a span{position:relative;z-index:1}

/* === PAGE SYSTEM === */
.page{display:none}
.page.active{display:block;animation:fadeIn .45s var(--ease)}

/* ==================== HOME ==================== */

/* --- HERO --- */
.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--dark);position:relative;overflow:hidden;padding:80px 24px}
/* Fog layers */
.hero-fog{position:absolute;inset:-10%;pointer-events:none}
.hero-fog .fog-layer{position:absolute;inset:0;border-radius:50%;filter:blur(80px);opacity:.15}
.hero-fog .fl1{background:radial-gradient(ellipse 40% 50% at 30% 40%,var(--blue-mid),transparent);animation:fogMove1 20s ease-in-out infinite}
.hero-fog .fl2{background:radial-gradient(ellipse 30% 40% at 65% 55%,rgba(163,200,224,.7),transparent);animation:fogMove2 18s ease-in-out infinite;opacity:.1}
.hero-fog .fl3{background:radial-gradient(ellipse 25% 35% at 50% 25%,rgba(107,158,200,.6),transparent);animation:fogMove3 22s ease-in-out infinite;opacity:.12}
.hero-fog .fl4{background:radial-gradient(ellipse 35% 45% at 70% 70%,rgba(61,109,144,.5),transparent);animation:fogMove1 24s ease-in-out infinite reverse;opacity:.08}
/* Particles */
.hero-particles{position:absolute;inset:0;pointer-events:none}
.hero-particles span{position:absolute;border-radius:50%}
.hero-particles .p1{width:120px;height:120px;top:15%;left:10%;background:radial-gradient(circle,rgba(163,200,224,.12),transparent);animation:drift1 28s ease-in-out infinite}
.hero-particles .p2{width:90px;height:90px;top:60%;right:8%;background:radial-gradient(circle,rgba(107,158,200,.1),transparent);animation:drift2 24s ease-in-out infinite}
.hero-particles .p3{width:150px;height:150px;bottom:10%;left:30%;background:radial-gradient(circle,rgba(145,185,215,.08),transparent);animation:drift3 32s ease-in-out infinite}
.hero-particles .dot{width:2px;height:2px;background:rgba(180,205,225,.5);animation:pulse 3s infinite}
.hero-particles .dot:nth-child(4){top:22%;left:25%;animation-delay:0s}
.hero-particles .dot:nth-child(5){top:35%;left:72%;animation-delay:.6s}
.hero-particles .dot:nth-child(6){top:48%;left:18%;animation-delay:1.2s}
.hero-particles .dot:nth-child(7){top:62%;left:78%;animation-delay:1.8s}
.hero-particles .dot:nth-child(8){top:75%;left:40%;animation-delay:2.4s}
.hero-particles .dot:nth-child(9){top:18%;left:55%;animation-delay:3s}
.hero-particles .dot:nth-child(10){top:80%;left:65%;animation-delay:.3s}
.hero-particles .dot:nth-child(11){top:42%;left:88%;animation-delay:1.5s}
.hero-inner{position:relative;z-index:2;max-width:700px;text-align:center}
.hero-icon{font-size:48px;margin-bottom:28px;display:block;line-height:1;filter:drop-shadow(0 4px 24px rgba(163,200,224,.35));animation:float 6s ease-in-out infinite}
.hero h1{font-size:clamp(40px,8vw,64px);font-weight:800;color:#fff;letter-spacing:10px;margin-bottom:24px;line-height:1.1;text-shadow:0 2px 40px rgba(107,158,200,.3)}
.hero h1 .hl{background:linear-gradient(135deg,#fff 30%,var(--blue-light) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero .lead{font-size:clamp(17px,2.6vw,21px);color:rgba(255,255,255,.72);line-height:1.85;font-weight:400;max-width:580px;margin:0 auto 10px}
.hero .lead em{color:var(--blue-light);font-style:normal;font-weight:600;text-shadow:0 0 30px rgba(163,200,224,.3)}
.hero .sub{font-size:13px;color:rgba(255,255,255,.28);letter-spacing:3px;margin-bottom:40px}
.hero-cta{display:inline-flex;align-items:center;gap:10px;padding:15px 40px;border-radius:var(--radius-pill);font-size:15px;font-weight:600;color:#fff;background:linear-gradient(135deg,var(--blue-mid),var(--blue-deep));border:none;cursor:pointer;transition:all .4s var(--ease);letter-spacing:1px;position:relative;overflow:hidden;box-shadow:0 8px 32px rgba(61,109,144,.3)}
.hero-cta:hover{transform:translateY(-3px);box-shadow:0 16px 48px rgba(61,109,144,.4);background:linear-gradient(135deg,#7aadd8,var(--blue-mid))}
.hero-cta::after{content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.15),transparent);transform:skewX(-25deg);animation:shimmer 2.5s infinite}
.hero-scroll{position:absolute;bottom:36px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;animation:pulse 2.5s infinite;cursor:pointer}
.hero-scroll span{font-size:10px;color:rgba(255,255,255,.2);letter-spacing:3px}
.hero-scroll .line{width:1px;height:32px;background:linear-gradient(180deg,rgba(163,200,224,.5),transparent)}

/* --- STATS --- */
.stats{padding:56px 24px;background:var(--dark2);text-align:center;position:relative}
.stats::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(163,200,224,.15),transparent)}
.stats-inner{max-width:var(--max);margin:0 auto;display:flex;justify-content:center;gap:72px;flex-wrap:wrap}
.stat-item{text-align:center}
.stat-num{font-size:40px;font-weight:800;color:var(--blue-light);line-height:1;margin-bottom:6px;text-shadow:0 0 30px rgba(163,200,224,.2)}
.stat-label{font-size:12px;color:rgba(255,255,255,.28);letter-spacing:1.5px}
@media(max-width:640px){.stats-inner{gap:32px}.stat-num{font-size:30px}}

/* --- QUOTES --- */
.quotes{padding:100px 24px 80px;max-width:var(--max);margin:0 auto;position:relative}
.quotes::before{content:'';position:absolute;top:40px;left:50%;transform:translateX(-50%);width:60px;height:2px;background:linear-gradient(90deg,transparent,var(--blue-mid),transparent)}
.quotes-label{text-align:center;font-size:11px;color:var(--text-faint);letter-spacing:5px;text-transform:uppercase;margin-bottom:48px}
.quotes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:36px}
@media(max-width:768px){.quotes-grid{grid-template-columns:1fr;max-width:440px;margin:0 auto;gap:28px}}
.quote-card{position:relative;padding:32px 28px 28px;background:var(--glass);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--border-glass);border-radius:var(--radius);box-shadow:var(--shadow-sm);transition:all .4s var(--ease)}
.quote-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--blue-pale)}
.quote-card .q-mark{position:absolute;top:-14px;left:20px;font-size:40px;color:var(--blue-pale);line-height:1;opacity:.5}
.quote-card .q-author{font-size:10px;font-weight:700;color:var(--blue-mid);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:14px}
.quote-card .q-en{font-size:13px;color:var(--text-body);line-height:1.75;font-style:italic;margin-bottom:8px}
.quote-card .q-cn{font-size:13px;color:var(--text-muted);line-height:1.75}

/* --- CAPABILITIES --- */
.cap-section{padding:0 24px 80px;position:relative}
.cap-inner{max-width:var(--max);margin:0 auto}
.cap-header{text-align:center;margin-bottom:56px}
.cap-header .cap-label{font-size:11px;color:var(--text-faint);letter-spacing:5px;text-transform:uppercase;margin-bottom:12px}
.cap-header h2{font-size:30px;font-weight:800;color:var(--blue-ink);margin-bottom:8px;letter-spacing:-.5px}
.cap-header p{font-size:15px;color:var(--text-muted);max-width:460px;margin:0 auto}
.cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;perspective:1200px}
@media(max-width:860px){.cap-grid{grid-template-columns:1fr;max-width:480px;margin:0 auto;perspective:none}}
.cap-card{position:relative;padding:36px 30px;border-radius:var(--radius);background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid var(--border-glass);cursor:pointer;transition:all .5s var(--ease);transform-style:preserve-3d;box-shadow:var(--shadow-sm);overflow:hidden}
.cap-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 40%,rgba(163,200,224,.08));opacity:0;transition:opacity .5s var(--ease)}
.cap-card:hover{transform:translateY(-8px) rotateX(2deg);box-shadow:0 24px 60px rgba(12,23,34,.1);border-color:var(--blue-light)}
.cap-card:hover::before{opacity:1}
.cap-card .cc-bg{position:absolute;top:-30px;right:-20px;font-size:140px;font-weight:900;color:rgba(163,200,224,.04);line-height:1;pointer-events:none;transition:all .6s var(--ease)}
.cap-card:hover .cc-bg{color:rgba(107,158,200,.1);transform:scale(1.15)rotate(-5deg)}
.cap-card .cc-icon{font-size:36px;margin-bottom:16px;display:block;transition:transform .4s var(--ease)}
.cap-card:hover .cc-icon{transform:scale(1.15)}
.cap-card h3{font-size:19px;font-weight:700;color:var(--blue-ink);margin-bottom:10px;position:relative}
.cap-card .cc-desc{font-size:13px;color:var(--text-muted);line-height:1.75;margin-bottom:12px}
.cap-card .cc-quote{font-size:11px;color:var(--blue-mid);font-style:italic;font-weight:500;margin-bottom:12px;padding-left:10px;border-left:2px solid var(--blue-pale)}
.cap-card .cc-meta{font-size:11px;color:var(--blue-deep);font-weight:600;transition:all .3s var(--ease)}
.cap-card:hover .cc-meta{letter-spacing:.5px}

/* --- ROLE STRIP --- */
.role-section{padding:64px 24px;background:var(--mist);position:relative}
.role-section::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--blue-pale),transparent)}
.role-section::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--blue-pale),transparent)}
.role-inner{max-width:var(--max);margin:0 auto;text-align:center}
.role-label{font-size:11px;color:var(--text-faint);letter-spacing:5px;margin-bottom:24px}
.role-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:768px){.role-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:440px){.role-grid{grid-template-columns:1fr;max-width:280px;margin:0 auto}}
.role-btn{padding:22px 18px;background:var(--glass);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid var(--border-glass);border-radius:var(--radius);cursor:pointer;transition:all .35s var(--ease);text-align:left}
.role-btn:hover{border-color:var(--blue-light);transform:translateY(-3px);box-shadow:0 12px 36px rgba(12,23,34,.06);background:rgba(255,255,255,.8)}
.role-btn .re{font-size:26px;margin-bottom:8px}
.role-btn .rn{font-size:14px;font-weight:700;color:var(--blue-ink);margin-bottom:4px}
.role-btn .rs{font-size:11px;color:var(--text-muted)}

/* --- FEATURED --- */
.featured{padding:90px 24px;background:var(--dark);position:relative;overflow:hidden}
.featured::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(163,200,224,.2),transparent)}
.featured::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(163,200,224,.15),transparent)}
.featured-bg{position:absolute;top:20%;right:-5%;width:400px;height:400px;background:radial-gradient(circle,rgba(107,158,200,.06),transparent 70%);pointer-events:none;animation:drift1 30s ease-in-out infinite}
.featured-inner{max-width:var(--max);margin:0 auto;position:relative;z-index:1}
.featured-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:40px}
.featured-header h2{font-size:20px;font-weight:700;color:rgba(255,255,255,.85);letter-spacing:2px}
.featured-header a{font-size:12px;color:rgba(163,200,224,.5);cursor:pointer;text-decoration:none;transition:color .3s;font-weight:500;padding:6px 16px;border:1px solid rgba(163,200,224,.2);border-radius:var(--radius-pill)}
.featured-header a:hover{color:var(--blue-light);border-color:rgba(163,200,224,.4)}
.featured-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
@media(max-width:640px){.featured-grid{grid-template-columns:1fr}}
.featured-item{display:flex;align-items:center;gap:16px;padding:18px 22px;background:rgba(255,255,255,.025);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.06);border-radius:var(--radius);cursor:pointer;transition:all .35s var(--ease);position:relative;overflow:hidden}
.featured-item::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(163,200,224,.04));opacity:0;transition:opacity .35s var(--ease)}
.featured-item:hover{background:rgba(255,255,255,.05);border-color:rgba(163,200,224,.25);transform:translateY(-3px);box-shadow:0 12px 36px rgba(0,0,0,.2)}
.featured-item:hover::after{opacity:1}
.featured-item .fi{font-size:26px;flex-shrink:0}
.featured-item .fn{flex:1}
.featured-item .fn .nm{font-size:14px;font-weight:600;color:rgba(255,255,255,.8);margin-bottom:3px}
.featured-item .fn .mt{font-size:11px;color:rgba(255,255,255,.25)}

/* --- CONTACT --- */
.contact{padding:72px 24px;max-width:var(--max);margin:0 auto;text-align:center}
.contact h2{font-size:20px;font-weight:700;color:var(--blue-ink);margin-bottom:6px;letter-spacing:1px}
.contact .cd{font-size:13px;color:var(--text-muted);margin-bottom:28px}
.contact-row{display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap}
.contact-qr{display:flex;align-items:center;gap:14px;padding:14px 22px;background:var(--glass);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--border-glass);border-radius:var(--radius);box-shadow:var(--shadow-sm)}
.contact-qr img{width:48px;height:48px;border-radius:8px}
.contact-qr .qt{text-align:left;font-size:11px;color:var(--text-muted);line-height:1.5}
.contact-qr .qt strong{color:var(--blue-ink);font-size:12px}
.contact-btn{display:inline-flex;align-items:center;gap:8px;padding:16px 30px;background:linear-gradient(135deg,var(--blue-mid),var(--blue-deep));color:#fff;border-radius:var(--radius-pill);font-size:13px;font-weight:600;text-decoration:none;transition:all .35s var(--ease);box-shadow:0 6px 24px rgba(61,109,144,.25)}
.contact-btn:hover{transform:translateY(-3px);box-shadow:0 12px 36px rgba(61,109,144,.35);background:linear-gradient(135deg,#7aadd8,var(--blue-mid))}

/* ==================== TOOLBOX ==================== */
.tb-hero{padding:120px 24px 56px;text-align:center;background:linear-gradient(180deg,var(--dark) 0%,var(--dark2) 100%);position:relative;overflow:hidden}
.tb-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 50% 40%,rgba(107,158,200,.06),transparent)}
.tb-hero h1{font-size:36px;font-weight:800;color:#fff;margin-bottom:8px;letter-spacing:2px}
.tb-hero p{font-size:14px;color:rgba(255,255,255,.4);max-width:480px;margin:0 auto}
.tb-container{max-width:var(--max);margin:0 auto;padding:0 24px 72px}

/* Toolbox Tabs */
.tb-tabs{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:36px 0}
.tb-tab{padding:10px 24px;border-radius:var(--radius-pill);font-size:13px;font-weight:500;cursor:pointer;border:1px solid var(--border);background:var(--glass);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:var(--text-muted);transition:all .3s var(--ease)}
.tb-tab:hover{border-color:var(--blue-light);color:var(--blue-deep)}
.tb-tab.active{background:linear-gradient(135deg,var(--blue-mid),var(--blue-deep));border-color:transparent;color:#fff;font-weight:600;box-shadow:0 4px 20px rgba(61,109,144,.3)}

.tb-panel{display:none}
.tb-panel.show{display:block;animation:fadeUp .5s var(--ease)}

/* Toolbox internals */
.tb-section-h{margin:28px 0 14px;display:flex;align-items:center;gap:10px}
.tb-section-h .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;background:var(--blue-mid);box-shadow:0 0 12px rgba(107,158,200,.4)}
.tb-section-h h3{font-size:15px;font-weight:700;color:var(--blue-ink);letter-spacing:.5px}

.tb-subtitle{margin:16px 0 12px;font-size:12px;font-weight:600;color:var(--blue-ink);letter-spacing:.5px;padding:10px 16px;background:var(--mist);border-left:3px solid var(--blue-mid);border-radius:0 var(--radius-sm) var(--radius-sm) 0}
.tb-subtitle .st{font-size:10px;color:var(--text-faint);font-weight:400;margin-left:8px}
.tb-subtitle.skill{border-left-color:var(--blue-deep);background:linear-gradient(135deg,var(--mist),rgba(208,228,242,.3))}

.tb-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:8px}
@media(max-width:640px){.tb-grid{grid-template-columns:1fr}}

.tb-card{padding:20px 22px;background:var(--glass);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--border-glass);border-radius:var(--radius);transition:all .38s var(--ease);position:relative;overflow:hidden}
.tb-card::after{content:'';position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent);transform:skewX(-20deg);transition:none}
.tb-card:hover{border-color:var(--blue-light);box-shadow:var(--shadow-md);transform:translateY(-2px)}
.tb-card:hover::after{left:200%;transition:left .6s var(--ease)}
.tb-card .badge{display:inline-block;font-size:9px;padding:3px 9px;border-radius:4px;font-weight:600;margin-bottom:8px;letter-spacing:.5px}
.badge-m{background:rgba(107,158,200,.1);color:var(--blue-deep)}
.badge-a{background:rgba(107,158,200,.07);color:#4a7898}
.badge-s{background:rgba(30,59,82,.07);color:var(--blue-ink)}
.tb-card h4{font-size:14px;font-weight:700;color:var(--blue-ink);margin-bottom:5px}
.tb-card .tb-desc{font-size:12px;color:var(--text-muted);line-height:1.7;margin-bottom:4px}
.tb-card .tb-desc .extra{color:var(--text-faint);font-size:10px}
.tb-card .tb-fit{font-size:10px;color:var(--text-faint)}
.tb-card .tb-links{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;font-size:10px}
.tb-card .tb-links a{color:var(--blue-deep);text-decoration:none;transition:color .2s;font-weight:500;padding:2px 0;border-bottom:1px solid transparent}
.tb-card .tb-links a:hover{color:var(--blue-mid);border-bottom-color:var(--blue-pale)}

/* All topics fold */
.tb-fold{margin-top:40px;text-align:center}
.tb-fold-btn{padding:11px 32px;border:1px solid var(--border);background:var(--glass);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-radius:var(--radius-pill);font-size:12px;color:var(--text-muted);cursor:pointer;transition:all .3s var(--ease);font-weight:500}
.tb-fold-btn:hover{border-color:var(--blue-mid);color:var(--blue-deep);box-shadow:0 4px 16px rgba(107,158,200,.1)}
.tb-fold-content{margin-top:24px;display:none}
.tb-fold-content.open{display:block;animation:fadeUp .45s var(--ease)}
.tb-cat-tabs{display:flex;gap:5px;justify-content:center;flex-wrap:wrap;margin-bottom:20px}
.tb-cat-tab{padding:5px 16px;border-radius:var(--radius-pill);font-size:11px;font-weight:500;color:var(--text-muted);background:var(--glass);border:1px solid var(--border);cursor:pointer;transition:all .25s var(--ease)}
.tb-cat-tab:hover{border-color:var(--blue-light);color:var(--blue-deep)}
.tb-cat-tab.active{background:linear-gradient(135deg,var(--blue-mid),var(--blue-deep));border-color:transparent;color:#fff}
.tb-cat-block{display:none}
.tb-cat-block.show{display:block}
.tb-cat-h{display:flex;align-items:center;gap:8px;padding-bottom:10px;border-bottom:1px solid var(--border);margin-bottom:10px}
.tb-cat-h h3{font-size:13px;font-weight:600;color:var(--blue-ink)}
.tb-cat-h .cnt{font-size:10px;color:var(--text-faint);margin-left:auto}
.tb-article{padding:14px 18px;background:var(--glass);border:1px solid var(--border-glass);border-radius:var(--radius-sm);margin-bottom:7px;cursor:pointer;transition:all .25s var(--ease);display:flex;align-items:center;gap:14px}
.tb-article:hover{border-color:var(--blue-light);box-shadow:var(--shadow-sm);transform:translateX(3px)}
.tb-article .ta-main{flex:1;min-width:0}
.tb-article h4{font-size:13px;font-weight:600;color:var(--blue-ink);margin-bottom:2px}
.tb-article .ta-desc{font-size:11px;color:var(--text-muted);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.tb-article .ta-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}
.tb-article .ta-tags span{font-size:9px;color:var(--blue-mid);background:rgba(107,158,200,.06);padding:2px 7px;border-radius:10px}
.tb-article .ta-right{text-align:right;flex-shrink:0}
.tb-article .ta-count{font-size:10px;color:var(--text-faint)}
.tb-article .ta-link{font-size:10px;color:var(--blue-mid)}

/* ==================== ABOUT ==================== */
.ab-hero{padding:120px 24px 56px;text-align:center;background:linear-gradient(180deg,var(--dark) 0%,var(--dark2) 100%);position:relative;overflow:hidden}
.ab-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 50% 40%,rgba(107,158,200,.06),transparent)}
.ab-hero h1{font-size:36px;font-weight:800;color:#fff;letter-spacing:8px;margin-bottom:8px}
.ab-hero p{font-size:14px;color:rgba(255,255,255,.4);letter-spacing:3px}
.ab-container{max-width:var(--max);margin:0 auto;padding:56px 24px 72px}

.ab-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:32px;margin-bottom:48px}
@media(max-width:768px){.ab-grid{grid-template-columns:1fr}}
.ab-main h2{font-size:21px;font-weight:700;color:var(--blue-ink);margin-bottom:14px}
.ab-main p{font-size:13.5px;color:var(--text-muted);line-height:1.9;margin-bottom:8px}
.ab-main .ah{color:var(--blue-mid);font-weight:600}
.ab-quote{padding:16px 22px;background:linear-gradient(135deg,var(--mist),rgba(208,228,242,.3));border-left:3px solid var(--blue-mid);border-radius:0 var(--radius-sm) var(--radius-sm) 0;font-size:13px;color:var(--blue-ink);font-weight:600;margin-top:14px}

.ab-companies{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ab-company{display:flex;align-items:center;gap:10px;padding:14px 16px;background:var(--glass);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid var(--border-glass);border-radius:var(--radius-sm);transition:all .3s var(--ease)}
.ab-company:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm)}
.ab-company .dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.ab-company .cn{font-size:12px;font-weight:600;color:var(--blue-ink)}
.ab-company .cr{font-size:9px;color:var(--text-faint);display:block}

/* Timeline */
.tl-section{margin:48px 0}
.tl-section h3{font-size:19px;font-weight:700;color:var(--blue-ink);margin-bottom:6px}
.tl-section .sub{font-size:13px;color:var(--text-muted);margin-bottom:28px}
.timeline{position:relative;padding-left:40px}
.timeline::before{content:'';position:absolute;left:14px;top:8px;bottom:8px;width:2px;background:linear-gradient(180deg,var(--blue-pale),var(--border),var(--blue-pale))}
.tl-item{display:flex;gap:22px;padding-bottom:32px;position:relative}
.tl-dot{width:30px;height:30px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:10px;color:#fff;font-weight:700;position:relative;z-index:1;box-shadow:0 4px 16px rgba(0,0,0,.15)}
.tl-body h3{font-size:15px;font-weight:600;color:var(--blue-ink);margin-bottom:2px}
.tl-body .tl-org{font-size:11px;color:var(--blue-mid);font-weight:500}
.tl-body p{font-size:12px;color:var(--text-muted);line-height:1.7;margin-top:4px}
.tl-body p strong{color:var(--blue-ink)}

/* Methodologies */
.mo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
@media(max-width:768px){.mo-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.mo-grid{grid-template-columns:1fr}}
.mo-card{padding:22px 20px;background:var(--glass);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid var(--border-glass);border-radius:var(--radius);transition:all .35s var(--ease)}
.mo-card:hover{border-color:var(--blue-light);transform:translateY(-3px);box-shadow:var(--shadow-md)}
.mo-card h4{font-size:14px;font-weight:600;color:var(--blue-ink);margin-bottom:5px}
.mo-card p{font-size:11px;color:var(--text-muted);line-height:1.7}

/* ==================== TRAINING ==================== */
.tr-hero{padding:120px 24px 56px;text-align:center;background:linear-gradient(180deg,var(--dark) 0%,var(--dark2) 100%);position:relative;overflow:hidden}
.tr-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 50% 40%,rgba(107,158,200,.06),transparent)}
.tr-hero h1{font-size:36px;font-weight:800;color:#fff;letter-spacing:8px;margin-bottom:8px}
.tr-hero p{font-size:14px;color:rgba(255,255,255,.4);letter-spacing:3px;max-width:480px;margin:0 auto}
.tr-container{max-width:var(--max);margin:0 auto;padding:56px 24px 72px}
.tr-section{margin-bottom:52px}
.tr-section-h{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.tr-section-h .ln{flex:1;height:1px;background:linear-gradient(90deg,var(--border),transparent)}
.tr-section-h h2{font-size:20px;font-weight:700;color:var(--blue-ink);letter-spacing:1px}
.tr-section-h .sub{font-size:12px;color:var(--text-faint);font-weight:400;letter-spacing:0}
/* Course Grid - 3 columns */
.tr-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:12px}
@media(max-width:900px){.tr-grid{grid-template-columns:1fr;max-width:460px;margin:0 auto}}
.tr-card{padding:32px 26px;background:var(--glass);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--border-glass);border-radius:var(--radius);position:relative;overflow:hidden;transition:all .4s var(--ease)}
.tr-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--blue-light)}
.tr-card .tc-tier{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue-light),var(--blue-mid))}
.tr-card .tc-tier.gold{background:linear-gradient(90deg,#d4b88a,#b8986a)}
.tr-card .tc-tier.green{background:linear-gradient(90deg,#7ab89a,#4a8a6a)}
.tr-card .tc-emoji{font-size:36px;display:block;margin-bottom:14px}
.tr-card h3{font-size:17px;font-weight:700;color:var(--blue-ink);margin-bottom:4px}
.tr-card .tc-meta{font-size:11px;color:var(--blue-mid);font-weight:600;margin-bottom:10px;display:flex;gap:8px;align-items:center}
.tr-card .tc-meta .dot{width:4px;height:4px;border-radius:50%;background:var(--blue-pale)}
.tr-card .tc-desc{font-size:12.5px;color:var(--text-muted);line-height:1.75;margin-bottom:10px}
.tr-card .tc-for{font-size:11px;color:var(--text-faint);margin-bottom:8px}
.tr-card .tc-features{list-style:none;padding:0;margin:0}
.tr-card .tc-features li{font-size:11.5px;color:var(--text-muted);padding:4px 0;padding-left:16px;position:relative;line-height:1.6}
.tr-card .tc-features li::before{content:'→';position:absolute;left:0;color:var(--blue-mid);font-weight:600}
.tr-card .tc-footer{margin-top:14px;padding-top:12px;border-top:1px solid var(--border)}
.tr-card .tc-footer span{font-size:10px;color:var(--text-faint);display:block;line-height:1.6}
/* Value prop strip */
.tr-value{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
@media(max-width:700px){.tr-value{grid-template-columns:1fr}}
.tr-v-item{padding:18px 20px;background:var(--mist);border-radius:var(--radius-sm);border-left:3px solid var(--blue-mid);transition:all .3s var(--ease)}
.tr-v-item:hover{background:rgba(208,228,242,.3);transform:translateX(3px)}
.tr-v-item h4{font-size:13px;font-weight:700;color:var(--blue-ink);margin-bottom:3px}
.tr-v-item p{font-size:11px;color:var(--text-muted);line-height:1.7}
/* Credential strip */
.tr-cred{display:flex;gap:16px;flex-wrap:wrap;margin:16px 0}
.tr-cred-item{flex:1;min-width:180px;padding:20px 24px;background:var(--glass);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid var(--border-glass);border-radius:var(--radius-sm);text-align:center}
.tr-cred-item .ce{font-size:28px;display:block;margin-bottom:6px}
.tr-cred-item .cn{font-size:12px;font-weight:600;color:var(--blue-ink);margin-bottom:3px}
.tr-cred-item .cs{font-size:10px;color:var(--text-faint)}
/* Book strip */
.tr-books{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
@media(max-width:700px){.tr-books{grid-template-columns:repeat(2,1fr)}}
.tr-book{padding:18px 16px;background:var(--glass);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid var(--border-glass);border-radius:var(--radius-sm);text-align:center;transition:all .3s var(--ease)}
.tr-book:hover{border-color:var(--blue-light);transform:translateY(-2px);box-shadow:var(--shadow-sm)}
.tr-book .be{font-size:26px;display:block;margin-bottom:6px}
.tr-book .bn{font-size:12px;font-weight:600;color:var(--blue-ink);margin-bottom:2px}
.tr-book .bs{font-size:10px;color:var(--text-faint)}
/* Arrow flow between courses */
.tr-arrow{text-align:center;padding:4px 0;font-size:20px;color:var(--blue-pale);letter-spacing:8px}
@media(max-width:900px){.tr-arrow{display:none}}

/* Footer */
.ft{text-align:center;padding:28px;font-size:11px;color:var(--text-faint);border-top:1px solid var(--border)}
.ft-dark{text-align:center;padding:28px;font-size:11px;color:rgba(255,255,255,.12);background:var(--dark)}

@media(max-width:640px){
  .nav{padding:0 18px}.nav-links a{padding:6px 12px;font-size:11px}
  .hero h1{letter-spacing:4px}.hero-icon{font-size:36px}
  .quotes{padding:60px 16px}
}
</style>
</head>
<body>

<!-- ==================== NAV ==================== -->
<nav class="nav" id="nav">
  <a class="nav-brand" onclick="switchPage('home')">
    <img src="assets/avatar.png" alt="" onerror="this.style.display='none'">
    <span>树懒老K</span>
  </a>
  <ul class="nav-links">
    <li><a class="active" onclick="switchPage('home')"><span>首页</span></a></li>
    <li><a onclick="switchPage('toolbox')"><span>工具箱</span></a></li>
    <li><a onclick="switchPage('training')"><span>培训课程</span></a></li>
    <li><a onclick="switchPage('about')"><span>关于</span></a></li>
  </ul>
</nav>

<!-- ==================== HOME ==================== -->
<div class="page active" id="page-home">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-fog"><div class="fog-layer fl1"></div><div class="fog-layer fl2"></div><div class="fog-layer fl3"></div><div class="fog-layer fl4"></div></div>
    <div class="hero-particles"><div class="p1"></div><div class="p2"></div><div class="p3"></div><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
    <div class="hero-inner">
      <span class="hero-icon">🦥</span>
      <h1><span class="hl">树懒老K</span></h1>
      <p class="lead">在车间和会议室之间走了<em>二十五年</em>。<br>AI时代最值钱的不是技术，是<em>定义问题、梳理问题、做出判断</em>的能力。</p>
      <p class="sub">用原创方法论帮你建立这些能力</p>
      <button class="hero-cta" onclick="switchPage('toolbox')">打开工具箱 →</button>
    </div>
    <div class="hero-scroll" onclick="document.getElementById('stats').scrollIntoView({behavior:'smooth'})">
      <span>向下探索</span><div class="line"></div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats" id="stats">
    <div class="stats-inner reveal">
      <div class="stat-item"><div class="stat-num">25+</div><div class="stat-label">年企业服务</div></div>
      <div class="stat-item"><div class="stat-num">300+</div><div class="stat-label">篇公众号文章</div></div>
      <div class="stat-item"><div class="stat-num">27</div><div class="stat-label">专题系列</div></div>
      <div class="stat-item"><div class="stat-num">20+</div><div class="stat-label">Agent Skill</div></div>
      <div class="stat-item"><div class="stat-num">6</div><div class="stat-label">原创方法论</div></div>
    </div>
  </section>

  <!-- QUOTES -->
  <section class="quotes">
    <div class="quotes-label reveal">三种能力的源头</div>
    <div class="quotes-grid">
      <div class="quote-card reveal reveal-delay-1"><div class="q-mark">"</div><div class="q-author">John Dewey · 约翰·杜威</div><div class="q-en">"A problem well stated is a problem half solved."</div><div class="q-cn">一个问题被清晰地定义出来，就已经解决了一半。</div></div>
      <div class="quote-card reveal reveal-delay-2"><div class="q-mark">"</div><div class="q-author">Albert Einstein · 爱因斯坦</div><div class="q-en">"If I had an hour to solve a problem, I'd spend 55 minutes thinking about the problem."</div><div class="q-cn">如果我一小时解决问题，先花55分钟思考问题本身。</div></div>
      <div class="quote-card reveal reveal-delay-3"><div class="q-mark">"</div><div class="q-author">Peter Drucker · 彼得·德鲁克</div><div class="q-en">"Nothing is so useless as doing efficiently what should not be done at all."</div><div class="q-cn">没有什么比高效地做一件不该做的事更无用的了。</div></div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="cap-section">
    <div class="cap-inner">
      <div class="cap-header reveal">
        <div class="cap-label">三种能力</div>
        <h2>AI时代不可替代的底层能力</h2>
        <p>当所有人都在追逐技术，我们停下来问：什么不会变？</p>
      </div>
      <div class="cap-grid">
        <div class="cap-card reveal reveal-delay-1" onclick="switchPageAndTab('toolbox','def')">
          <div class="cc-bg">01</div><span class="cc-icon">🎯</span>
          <h3>定义问题的能力</h3>
          <p class="cc-desc">当所有人都急着找答案，你先停下来问：我们要解决的到底是什么问题？</p>
          <p class="cc-quote">"A problem well stated is a problem half solved."</p>
          <p class="cc-meta">3个方法论 · 7个专题 · 3个Agent Skill →</p>
        </div>
        <div class="cap-card reveal reveal-delay-2" onclick="switchPageAndTab('toolbox','str')">
          <div class="cc-bg">02</div><span class="cc-icon">🧩</span>
          <h3>梳理问题的能力</h3>
          <p class="cc-desc">把复杂问题拆解成可执行的框架，让模糊的焦虑变成清晰的路径。</p>
          <p class="cc-quote">"55分钟思考问题本身，5分钟解决问题。"</p>
          <p class="cc-meta">5个方法论 · 9个专题 · 4个Agent Skill →</p>
        </div>
        <div class="cap-card reveal reveal-delay-3" onclick="switchPageAndTab('toolbox','jud')">
          <div class="cc-bg">03</div><span class="cc-icon">⚖️</span>
          <h3>做出判断的能力</h3>
          <p class="cc-desc">在多种可能性中做出选择——不只是选对，还要知道什么不该做。</p>
          <p class="cc-quote">"高效地做不该做的事，比不做更糟。"</p>
          <p class="cc-meta">2个方法论 · 11个专题 · 9个Agent Skill →</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROLE STRIP -->
